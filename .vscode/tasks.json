{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "g++: build binning",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-fdiagnostics-color=always",
                "-g",
                "src/main.cpp",
                "src/config.cpp",
                "src/read_parse_sps.cpp",
                "src/save_data.cpp",
                "src/bins.cpp",
                "src/binning.cpp",
                "-Iinclude",
                "-o",
                "${workspaceFolder}/bin/debug/binning",
                "-lsqlite3"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "g++: build active file",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-Iinclude",
                "-Id:/cpp/boost_1_91_0",
                "-o",
                "${workspaceFolder}/bin/debug/${fileBasename}",
                "-lsqlite3"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }

    ]
}